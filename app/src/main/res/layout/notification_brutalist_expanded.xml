<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_brutalist_notification"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top header badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_expanded_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_brutalist_notif_badge"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="[ DISPATCH ALERT ]"
            android:textColor="#FFE600"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_expanded_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_brutalist_notif_tag"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="CONSISTENCY"
            android:textColor="#121212"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Title -->
    <TextView
        android:id="@+id/notif_expanded_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:maxLines="2"
        android:text="Execute Planned Target"
        android:textColor="#121212"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Description or detail -->
    <TextView
        android:id="@+id/notif_expanded_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:text="Maintain relentless daily momentum. Complete objective to preserve your streak."
        android:textColor="#2A2A2A"
        android:textSize="12sp" />

    <!-- Brutalist Call-To-Action button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_cta_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_brutalist_notif_btn"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="[ OPEN &amp; EXECUTE → ]"
            android:textColor="#FFE600"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
